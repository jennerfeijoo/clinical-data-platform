include build_backend.py
include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md
include SUPPORT.md
include CONTRIBUTING.md
include CITATION.cff
recursive-include docs *.md
recursive-include scripts *.py *.ps1 *.sh
recursive-include sql *.sql
recursive-include data/sample *.csv
recursive-include security *.json
recursive-include tests *.py *.csv *.json *.toml
prune data/raw
prune data/processed
prune data/analytics
prune data/synthea
prune benchmarks
prune .github
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
